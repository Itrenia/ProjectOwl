# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# Receipt extraction. LLM_PROVIDER is "openrouter" (default) or "gemini";
# only the chosen provider's key is needed.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: comma-separated models tried in order, one per attempt.
# OPENROUTER_MODELS=deepseek/deepseek-v4.1-flash,google/gemini-3.5-flash-lite
# GEMINI_MODELS=gemini-flash-lite-latest,gemini-flash-latest

# Optional: Development/Debug settings
NEXT_PUBLIC_DEBUG_UI=false
NEXT_PUBLIC_MOCK_SCAN=false
